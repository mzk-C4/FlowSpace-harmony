{
  "name": "flowspace-mindmap",
  "version": "2.0.1",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=backend/.env backend/server.mjs",
    "check": "node tools/check-integration.mjs",
    "test": "node --test backend/tests/*.test.mjs tools/tests/*.mjs docs/preview/test-preview.mjs",
    "build:harmony": "pwsh -NoProfile -File tools/build-harmony.ps1",
    "try:ai": "node tools/try-generation.mjs",
    "preview:native": "pwsh -NoProfile -File tools/preview-native.ps1 -CaptureAll",
    "phone:check": "pwsh -NoProfile -File tools/test-phone.ps1 -DryRun",
    "test:phone-scripts": "pwsh -NoProfile -File tools/tests/phone-workflow.ps1"
  }
}
